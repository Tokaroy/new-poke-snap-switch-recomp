#version 450
// SPDX-License-Identifier: MIT
// Smooth camera (runtime/nvn/nvn_smoothcam.cpp, project code, ours): copies this frame's scene depth into a host-owned R32F image at
// the upscale point, so the in-between frames presented later still read this frame's depth after the game reuses its target.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D depth_tex;
layout(binding = 1, r32f) uniform writeonly image2D depth_out;
layout(push_constant) uniform P { ivec2 size; } pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.size.x || p.y >= pc.size.y) return;
    imageStore(depth_out, p, vec4(texelFetch(depth_tex, p, 0).r, 0.0, 0.0, 0.0));
}
